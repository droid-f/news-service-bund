    <content lang="fr">
      <city>Berne</city>
      <title>Avis de publication</title>
      <lead>Avis de publication de l’affaire CF du 12.12.2025</lead>
      <text link="no">&lt;p&gt;Lors de sa séance du 12.12.2025, le Conseil fédéral a adopté le rapport donnant suite au postulat 22.3751 Gredig du 16 juin 2022.&lt;/p&gt;</text>
      <contact>Communication DFAE Bundeshaus West 3003 Berne +41 58 460 55 55 kommunikation@eda.admin.ch</contact>
      <revisions/>
    </content>
    <content lang="de">
      <city>Bern</city>
      <title>Publikationshinweis</title>
      <lead>Publikationshinweis BR-Geschäft vom 12.12.2025</lead>
      <text link="no">&lt;p&gt;An seiner Sitzung vom 12.12.2025, hat der Bundesrat den Bericht zur Erfüllung des Postulats 22.3751 Gredig vom 16. Juni 2022 verabschiedet.&lt;/p&gt;</text>
      <contact>Kommunikation EDA Bundeshaus West 3003 Bern +41 58 460 55 55 kommunikation@eda.admin.ch</contact>
      <revisions/>
    </content>
    <content lang="it">
      <city>Berna</city>
      <title>Avviso di pubblicazione</title>
      <lead>Avviso di pubblicazione del caso CF del 12.12.2025</lead>
      <text link="no">&lt;p&gt;Nella sessione del 12.12.2025, il Consiglio federale ha adottato il rapporto in risposta al postulato 22.3751 Gredig del 10 giugno 2022.&lt;/p&gt;</text>
      <contact>Comunicazione DFAE Bundeshaus West 3003 Berna +41 58 460 55 55 kommunikation@eda.admin.ch</contact>
      <revisions/>
    </content>
