    <content lang="it">
      <city>Berna</city>
      <title>Avviso di pubblicazione</title>
      <lead>Approvazione del rapporto intermediario Gestione dei dati a livello nazionale (NaDB)</lead>
      <text link="no">&lt;p&gt;Durante la seduta del 13 giugno 2025, il Consiglio federale ha approvato il rapporto intermediario Gestione dei dati a livello nazionale (NaDB).&lt;/p&gt; &lt;p&gt;&lt;a target="_blank" rel="noopener" href="https://cms.news.admin.ch/fileservice/sdweb-docs-prod-nsbcch-files/files/2025/06/13/072613c8-8126-4655-bdd3-9b04d538587c.pdf" data-li-file-ref="oYlj5Aw3BUoL" data-mime-type="application/pdf"&gt;Rapport intermediaire sur le programme de gestion nationale des données (NaDB&lt;/a&gt;)&lt;/p&gt;</text>
      <contact>Ufficio federale di statistica Ufficio stampa +41 58 463 60 13 media@bfs.admin.ch</contact>
      <revisions/>
    </content>
    <content lang="fr">
      <city>Berne</city>
      <title>Avis de publication</title>
      <lead>Approbation du rapport intermédiaire Programme de gestion nationale des données (NaDB).</lead>
      <text link="no">&lt;p&gt;Lors de sa séance du 13 juin 2025, le Conseil fédéral a approuvé le rapport intermédiaire Programme de gestion nationale des données (NaDB).&lt;/p&gt; &lt;p&gt;&lt;a target="_blank" rel="noopener" href="https://cms.news.admin.ch/fileservice/sdweb-docs-prod-nsbcch-files/files/2025/06/13/072613c8-8126-4655-bdd3-9b04d538587c.pdf" data-li-file-ref="oYlj5Aw3BUoL" data-mime-type="application/pdf"&gt;Rapport intermédiaire sur le programme de gestion nationale des données (NaDB)&lt;/a&gt;&lt;/p&gt;</text>
      <contact>Office fédéral de la statistique Services des médias +41 58 463 60 13 media@bfs.admin.ch</contact>
      <revisions/>
    </content>
    <content lang="de">
      <city>Bern</city>
      <title>Publikationshinweis</title>
      <lead>Genehmigung des Zwischenberichts Nationale Datenbewirtschaftung (NaDB)</lead>
      <text link="no">&lt;p&gt;Der Bundesrat hat an seiner Sitzung vom 13. Juni 2025 den Zwischenbericht NaDB genehmigt.&lt;/p&gt; &lt;p&gt;&lt;a target="_blank" rel="noopener" href="https://cms.news.admin.ch/fileservice/sdweb-docs-prod-nsbcch-files/files/2025/06/13/91bc1401-81aa-45da-a3d9-3c3ab55461ee.pdf" data-li-file-ref="DEyjScbreNZ8" data-mime-type="application/pdf"&gt;Zwischenbericht Programm Nationale Datenbewirtschaftung (NaDB)&lt;/a&gt;&lt;/p&gt;</text>
      <contact>Bundesamt für Statistik Medienstelle +41 58 463 60 13 media@bfs.admin.ch</contact>
      <revisions/>
    </content>
