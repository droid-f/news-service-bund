    <content lang="it">
      <city>Berna</city>
      <title>Avviso di pubblicazione</title>
      <lead>Finanziamento di progetti di digitalizzazione decentralizzati ; Rapporto del Consiglio federale in adempimento della mozione 22.4255 della CdF-N del 13 ottobre 2022.</lead>
      <text link="no">&lt;p&gt;Nella seduta del 6 maggio 2026, il Consiglio federale ha adottato il rapporto « Finanziamento di progetti di digitalizzazione decentralizzati ».&lt;/p&gt; &lt;p&gt;&lt;a href="https://www.efd.admin.ch/it/rapporti" target="_blank"&gt;Rapporti&lt;/a&gt;&lt;/p&gt;</text>
      <contact>Dipartimento federale delle finanze DFF Comunicazione DFF +41 58 462 60 33 media@gs-efd.admin.ch</contact>
      <revisions/>
    </content>
    <content lang="fr">
      <city>Berne</city>
      <title>Avis de publication</title>
      <lead>Financement des projets de numérisation décentralisés ; Rapport du Conseil fédéral donnant suite à la motion 22.4255 de la Commission des finances du Conseil national du 13 octobre 2022.</lead>
      <text link="no">&lt;p&gt;Lors de sa séance du 6 mai 2026, le Conseil fédéral a adopté le rapport « Financement des projets de numérisation décentralisés ».&lt;/p&gt; &lt;p&gt;&lt;a href="https://www.efd.admin.ch/fr/rapports" target="_blank"&gt;Rapports&lt;/a&gt;&lt;/p&gt;</text>
      <contact>Département fédéral des finances DFF Communication DFF +41 58 462 60 33 media@gs-efd.admin.ch</contact>
      <revisions/>
    </content>
    <content lang="de">
      <city>Bern</city>
      <title>Publikationshinweis</title>
      <lead>Finanzierung von dezentralen Digitalisierungsprojekten; Bericht des Bundesrates in Erfüllung der Motion 22.4255 der FK-N vom 13. Oktober 2022.</lead>
      <text link="no">&lt;p&gt;Der Bundesrat hat an seiner Sitzung vom 6. Mai 2026 den Bericht «Finanzierung von dezentralen Digitalisierungsprojekten» gutgeheissen.&lt;/p&gt; &lt;p&gt;&lt;a href="https://www.efd.admin.ch/de/berichte"&gt;Berichte&lt;/a&gt;&lt;/p&gt;</text>
      <contact>Eidgenössisches Finanzdepartement EFD Kommunikation EFD +41 58 462 60 33 media@gs-efd.admin.ch</contact>
      <revisions/>
    </content>
